NODE_ENV=development
PORT=3000

# postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/logistica_entregas?schema=public"

# Mínimo 32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="1h"

# Chave exigida no cabeçalho X-API-KEY em TODAS as rotas (inclusive /health).
# Mínimo 20 caracteres. Gere com o mesmo comando usado para o JWT_SECRET.
API_KEY="troque-por-outra-chave-longa-e-aleatoria"

UPLOAD_DIR="uploads"
UPLOAD_MAX_SIZE_BYTES=5242880

CEP_API_BASE_URL="https://viacep.com.br/ws"
CEP_API_TIMEOUT_MS=5000

# Somente para `npm run seed` (padrão de desenvolvimento: Senha@1234)
# SEED_PASSWORD="defina-uma-senha"
